# Everything is installed from the checkout this script lives in: no second
# copy is downloaded, so the install always matches the code you are reading.
dots_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd)

initial_checks() {
    # Verificar usuario root
    if [ "$(id -u)" = 0 ]; then
        printf "This script MUST NOT be run as root user."
        exit 1
    fi

    if [ ! -d "$dots_dir/config/bspwm" ] || [ ! -d "$dots_dir/misc" ]; then
        printf "${BLD}${CRE}This installer has to run from a clone of the dotfiles.${CNC}\n\n"
        printf "  Looked in: ${BLD}${CYE}%s${CNC}\n" "$dots_dir"
        printf "  config/ and misc/ must sit next to the script.\n\n"
        printf "  git clone https://github.com/Karataso/dotfiles ~/dotfiles\n"
        printf "  ~/dotfiles/RiceInstaller\n\n"
        exit 1
    fi
}

