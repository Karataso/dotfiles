show_source() {
    clear
    logo "Installing dotfiles"
    printf "%b\n" "${BLD}${CYE}Source: ${CBL}${dots_dir}${CNC}"

    if [ -d "$dots_dir/.git" ]; then
        branch=$(git -C "$dots_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        commit=$(git -C "$dots_dir" log -1 --format='%h %s' 2>/dev/null)
        [ -n "$branch" ] && printf "%b\n" "${BLD}${CYE}Branch: ${CBL}${branch}${CNC}"
        [ -n "$commit" ] && printf "%b\n" "${BLD}${CYE}Commit: ${CBL}${commit}${CNC}"
    fi
    sleep 2
}

backup_existing_config() {
    clear
    logo "Backup files"
    sleep 2

    printf "%b" "Any existing configuration (bspwm, polybar, kitty, zsh, dunst, etc)\ncan be moved out of the way to ${CYE}~/.RiceBackup${CNC} before installing.\nSaying no leaves your files where they are: anything they share with the dots gets overwritten.\n\n"

    while :; do
        printf "%b" "${BLD}${CYE}Back up your current configuration? ${CNC}[Y/n]: "
        read -r do_backup
        case "$do_backup" in
            [Yy]|"") do_backup="y"; break ;;
            [Nn]) do_backup="n"; break ;;
            *) printf " %b%bError:%b write 'y' or 'n'\n" "${BLD}" "${CRE}" "${CNC}" ;;
        esac
    done

    if [ "$do_backup" != "y" ]; then
        printf "\n%b\n\n" "${BLD}${CYE}No backup taken. Installing over what is there.${CNC}"
        sleep 3
        return
    fi

    backup_folder="$HOME/.RiceBackup/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_folder"
    printf "\n%b\n\n" "${BLD}${CYE}Backup directory: ${CBL}$backup_folder${CNC}"
    sleep 1

    # Dirs in ~/.config/
    cfg_dir="bspwm cava clipcat picom rofi eww sxhkd dunst jgmenu kitty polybar geany gtk-3.0 ncmpcpp yazi zsh mpd mpv paru zathura"
    for cfg in $cfg_dir; do
        [ -d "$HOME/.config/$cfg" ] && mv "$HOME/.config/$cfg" "$backup_folder"
    done

    # Individual files/dirs in Home
    for f in ".icons" ".zshrc" ".gtkrc-2.0"; do
        [ -e "$HOME/$f" ] && mv "$HOME/$f" "$backup_folder"
    done

    printf "\n%b\n\n" "${BLD}${CGR}All files moved to:${CNC} ${BLD}${CYE}$backup_folder${CNC}"
    sleep 3
}

install_dotfiles() {
    clear
    logo "Installing dotfiles.."
    printf "%s%s Copying files to respective directories...%s\n\n" "$BLD" "$CBL" "$CNC"
    sleep 2

    # Create required directories if not exists
    for dir in "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share"; do
        if [ ! -d "$dir" ]; then
            mkdir -p "$dir" && \
            printf "%s%sCreated directory: %s%s%s\n" "$BLD" "$CGR" "$CBL" "$dir" "$CNC"
        fi
    done

    # Copy files to ~/.config
    dots_config_dir="bspwm cava clipcat dunst geany gtk-3.0 jgmenu kitty mpd mpv ncmpcpp paru systemd yazi zsh zathura"
    for dots_cfg in $dots_config_dir; do
        cp -R "$dots_dir/config/$dots_cfg" "$HOME/.config/"
    done

    # cp -R merges, so rices and bars deleted from the dotfiles would survive
    # forever in an existing install. Drop anything the source tree no longer has.
    for kind in rices bars; do
        src="$dots_dir/config/bspwm/$kind"
        dst="$HOME/.config/bspwm/$kind"
        [ -d "$src" ] && [ -d "$dst" ] || continue

        for installed in "$dst"/*/; do
            [ -d "$installed" ] || continue
            name=$(basename "$installed")
            if [ ! -d "$src/$name" ]; then
                printf "%s%sRemoving %s: %s%s%s\n" "$BLD" "$CYE" "$kind" "$CBL" "$name" "$CNC"
                rm -rf "$installed"
            fi
        done
    done

    # Never leave .rice pointing at a theme that just went away
    if [ -f "$HOME/.config/bspwm/.rice" ]; then
        current_rice=$(cat "$HOME/.config/bspwm/.rice")
        if [ ! -d "$HOME/.config/bspwm/rices/$current_rice" ]; then
            first_rice=$(find "$HOME/.config/bspwm/rices" -mindepth 1 -maxdepth 1 -type d | sort | head -n 1)
            if [ -n "$first_rice" ]; then
                basename "$first_rice" > "$HOME/.config/bspwm/.rice"
                printf "%s%sTheme '%s' is gone, falling back to %s%s\n" "$BLD" "$CYE" "$current_rice" "$(basename "$first_rice")" "$CNC"
            fi
        fi
    fi

    # Copy files to ~/.local/share
    dots_misc_dir="applications asciiart fonts"
    for dots_misc in $dots_misc_dir; do
        cp -R "$dots_dir/misc/$dots_misc" "$HOME/.local/share/"
    done

    # Copy bin dir to ~/.local
    cp -R "$dots_dir/misc/bin" "$HOME/.local/"


    # Copy remaining files
    dots_home_dir=".icons .zshrc .gtkrc-2.0"
    for dots_home in $dots_home_dir; do
        cp -R "$dots_dir/home/$dots_home" "$HOME/"
    done

    # Copying polybar-update.hook
    if [ ! -d /etc/pacman.d/hooks ]; then
        sudo mkdir -p /etc/pacman.d/hooks
    fi

    sudo cp "$dots_dir/misc/polybar-update.hook" /etc/pacman.d/hooks

    # Update font cache
    fc-cache -r

    # Generate xdg dirs
    if [ ! -e "$HOME/.config/user-dirs.dirs" ]; then
        xdg-user-dirs-update
    fi

    # bspwmrc starts sxhkd with this exact file, so prove the installed copy is
    # the one we ship instead of leaving "the keybinds did nothing" to guesswork.
    installed_sxhkdrc="$HOME/.config/bspwm/config/sxhkdrc"
    if [ -f "$installed_sxhkdrc" ]; then
        if cmp -s "$dots_dir/config/bspwm/config/sxhkdrc" "$installed_sxhkdrc"; then
            bindings=$(grep -cE '^[^[:space:]#].*\+' "$installed_sxhkdrc")
            printf "%s%sKeybinds: %s bindings installed in %s%s%s\n" \
                "$BLD" "$CGR" "$bindings" "$CBL" "$installed_sxhkdrc" "$CNC"
        else
            printf "%s%sWarning: %s differs from the keybinds being installed.%s\n" \
                "$BLD" "$CRE" "$installed_sxhkdrc" "$CNC"
        fi
    else
        printf "%s%sWarning: no sxhkdrc was installed, the keybinds will not work.%s\n" \
            "$BLD" "$CRE" "$CNC"
    fi

    # Apply them now if this is being run inside a live bspwm session
    if pkill -USR1 -x sxhkd 2>/dev/null; then
        printf "%s%sReloaded sxhkd with the new keybinds.%s\n" "$BLD" "$CGR" "$CNC"
    fi

    printf "\n%s%sDotfiles installed successfully!%s\n" "$BLD" "$CGR" "$CNC"
    sleep 3
}

setup_display_manager() {
    clear
    logo "Configuring Display Manager"
    sleep 2

    # Never fight a display manager the user already has enabled
    dm_enabled=""
    for dm in gdm sddm lxdm ly greetd xdm lightdm; do
        if systemctl is-enabled --quiet "${dm}.service" 2>/dev/null; then
            dm_enabled="$dm"
            break
        fi
    done

    if [ -n "$dm_enabled" ] && [ "$dm_enabled" != "lightdm" ]; then
        printf "%b\n\n" "${BLD}${CYE}${dm_enabled} is already enabled as your display manager. Skipping LightDM setup.${CNC}"
        sleep 3
        return
    fi

    if [ "$dm_enabled" = "lightdm" ]; then
        printf "%b\n" "${BLD}${CYE}LightDM is already enabled, refreshing its configuration...${CNC}"
    else
        printf "%b" "A display manager is what greets you after boot and starts your bspwm session.\nNo enabled display manager was found.\n\n"

        while :; do
            printf "%b" "${BLD}${CYE}Install and enable LightDM with the bspwm session? ${CNC}[Y/n]: "
            read -r install_lightdm
            case "$install_lightdm" in
                [Yy]|"") install_lightdm="y"; break ;;
                [Nn]) install_lightdm="n"; break ;;
                *) printf " %b%bError:%b write 'y' or 'n'\n" "${BLD}" "${CRE}" "${CNC}" ;;
            esac
        done

        if [ "$install_lightdm" != "y" ]; then
            printf "\n%b\n\n" "${BLD}${CYE}Skipping LightDM setup.${CNC}"
            sleep 2
            return
        fi
    fi

    # xorg-server is a safety net for minimal installs without X11
    printf "%b\n" "${BLD}${CYE}Installing LightDM...${CNC}"
    if ! sudo pacman -S --noconfirm --needed lightdm xorg-server; then
        printf "\n%b\n\n" "${BLD}${CRE}Failed to install LightDM. Skipping its configuration.${CNC}"
        sleep 3
        return
    fi

    # web-greeter only lives in the AUR. Building it on every install is slow
    # and, with detect_theme_errors on, it silently swaps out any theme that
    # throws, so it is used only when it is already installed. The GTK greeter
    # is the default: it gets the active rice's GTK theme and a random
    # wallpaper from that rice (see misc/lightdm/dots-greeter).
    greeter_session="lightdm-gtk-greeter"
    greeter_theme_name=""
    themes_dir="/usr/share/web-greeter/themes"
    if pacman -Q web-greeter >/dev/null 2>&1; then
        greeter_session="web-greeter"
        greeter_theme_name="default"
        if [ ! -d "$themes_dir/default" ]; then
            greeter_theme_name=$(find "$themes_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | head -n 1)
        fi
        [ -n "$greeter_theme_name" ] || greeter_theme_name="default"
        printf "%b\n" "${BLD}${CYE}web-greeter is installed, using its ${CBL}${greeter_theme_name}${CYE} theme.${CNC}"
    else
        printf "%b\n" "${BLD}${CYE}Using the GTK greeter, themed from the active rice...${CNC}"
        if ! sudo pacman -S --noconfirm --needed lightdm-gtk-greeter; then
            printf "\n%b\n\n" "${BLD}${CRE}Failed to install a greeter. Skipping LightDM configuration.${CNC}"
            sleep 3
            return
        fi
    fi

    # LightDM runs this before every greeter, so the login screen follows the
    # rice you are using instead of whatever was picked at install time
    printf "%b\n" "${BLD}${CYE}Installing the greeter setup script...${CNC}"
    if sudo install -m 755 "$dots_dir/misc/lightdm/dots-greeter" /usr/local/bin/dots-greeter; then
        sudo sed -i "s|^DOTS_HOME=.*|DOTS_HOME=\"$HOME\"|" /usr/local/bin/dots-greeter
    else
        printf "%b\n" "${BLD}${CRE}Could not install the greeter script, the login screen will keep its default look.${CNC}"
    fi

    # Register the bspwm session so the greeter can start it
    printf "%b\n" "${BLD}${CYE}Creating bspwm session entry...${CNC}"
    sudo mkdir -p /usr/local/share/xsessions
    sudo tee /usr/local/share/xsessions/bspwm.desktop >/dev/null <<'EOF'
[Desktop Entry]
Name=Bspwm
Comment=Binary space partitioning window manager
Exec=/usr/bin/bspwm
Type=Application
Keywords=wm;
EOF

    # Set the greeter and make bspwm the default session
    lightdm_conf="/etc/lightdm/lightdm.conf"
    if [ -f "$lightdm_conf" ]; then
        if [ ! -f "${lightdm_conf}.bak" ]; then
            sudo cp "$lightdm_conf" "${lightdm_conf}.bak"
        fi

        set_lightdm_option() {
            key="$1"
            value="$2"
            # Respect values the user already set explicitly, unless we just
            # installed the greeter and need the session to match it.
            if [ "$3" != "force" ] && sudo grep -qE "^${key}=" "$lightdm_conf"; then
                printf "%b\n" "${BLD}${CYE}Keeping existing ${key}=${CNC}"
            elif sudo grep -qE "^[#[:space:]]*${key}=" "$lightdm_conf"; then
                sudo sed -i "s|^[#[:space:]]*${key}=.*|${key}=${value}|" "$lightdm_conf"
            elif sudo grep -q '^\[Seat:\*\]' "$lightdm_conf"; then
                sudo sed -i "/^\[Seat:\*\]/a ${key}=${value}" "$lightdm_conf"
            else
                printf '\n[Seat:*]\n%s=%s\n' "$key" "$value" | sudo tee -a "$lightdm_conf" >/dev/null
            fi
        }

        set_lightdm_option greeter-session "$greeter_session" force
        set_lightdm_option user-session bspwm
        set_lightdm_option greeter-setup-script /usr/local/bin/dots-greeter
    else
        printf "%b\n" "${BLD}${CRE}LightDM config not found: ${CYE}${lightdm_conf}${CNC}"
    fi

    # Point web-greeter at that theme, preserving the rest of its config
    if [ "$greeter_session" = "web-greeter" ] && [ -n "$greeter_theme_name" ]; then
        web_greeter_conf="/etc/lightdm/web-greeter.toml"

        if [ -f "$web_greeter_conf" ] && [ ! -f "${web_greeter_conf}.bak" ]; then
            sudo cp "$web_greeter_conf" "${web_greeter_conf}.bak"
        fi

        if [ ! -f "$web_greeter_conf" ]; then
            printf '[greeter]\ntheme = "%s"\n' "$greeter_theme_name" | sudo tee "$web_greeter_conf" >/dev/null
        elif sudo grep -qE '^[[:space:]]*theme[[:space:]]*=' "$web_greeter_conf"; then
            sudo sed -i "s|^[[:space:]]*theme[[:space:]]*=.*|theme = \"${greeter_theme_name}\"|" "$web_greeter_conf"
        elif sudo grep -qE '^\[greeter\]' "$web_greeter_conf"; then
            sudo sed -i "/^\\[greeter\\]/a theme = \"${greeter_theme_name}\"" "$web_greeter_conf"
        else
            printf '\n[greeter]\ntheme = "%s"\n' "$greeter_theme_name" | sudo tee -a "$web_greeter_conf" >/dev/null
        fi
    fi

    # Hook for the greeter script. It rewrites this stylesheet and the image
    # it points at on every boot, so the link only has to be added once.
    if [ "$greeter_session" = "web-greeter" ] && [ -n "$greeter_theme_name" ]; then
        theme_index="$themes_dir/$greeter_theme_name/index.html"
        if [ -f "$theme_index" ] && ! grep -q 'dots-wallpaper.css' "$theme_index"; then
            patched=$(mktemp)
            awk '
                /<\/head>/ && !done {
                    print "<link rel=\"stylesheet\" href=\"dots-wallpaper.css\" id=\"dots-wallpaper\">"
                    done = 1
                }
                { print }
            ' "$theme_index" > "$patched" &&
                sudo cp "$patched" "$theme_index"
            rm -f "$patched"
        fi
    fi

    # Paint the login screen now too, so it looks right before the first boot
    sudo /usr/local/bin/dots-greeter 2>/dev/null

    printf "%b\n" "${BLD}${CYE}Enabling LightDM...${CNC}"
    sudo systemctl enable lightdm.service
    sudo systemctl set-default graphical.target

    printf "%b\n\n" "${BLD}${CGR}LightDM is enabled. Pick the 'Bspwm' session at the login screen.${CNC}"
    sleep 3
}

configure_services() {
    clear
    logo "Configuring Services"
    picom_config="$HOME/.config/bspwm/config/picom/picom.conf"
    sleep 2

    # MPD Service Management
    if systemctl is-enabled --quiet mpd.service; then
        printf "%b\n" "${BLD}${CYE}Disabling global MPD service...${CNC}"
        sudo systemctl disable --now mpd.service
    fi

    # User-level MPD Service
    printf "%b\n" "${BLD}${CYE}Enabling user MPD service...${CNC}"
    systemctl --user enable --now mpd.service

    # User-level ArchUpdates
    printf "%b\n" "${BLD}${CYE}Enabling user ArchUpdates service...${CNC}"
    systemctl --user enable --now ArchUpdates.timer

    # Virtual Machine Detection
    is_virtual_machine() {
        systemd-detect-virt --quiet >/dev/null 2>&1
    }

    # Picom Configuration for VMs
    if is_virtual_machine; then
        printf "%b\n" "${BLD}${CYE}Virtual machine detected${CNC}"
        printf "\n%b\n" "${BLD}${CYE}Adjusting Picom configuration...${CNC}"

        if [ -f "$picom_config" ]; then
            if sed -i 's/backend = "glx"/backend = "xrender"/' "$picom_config"; then
                printf "%b\n" "${BLD}${CGR}Picom backend changed to xrender${CNC}"
            else
                printf "%b\n" "${BLD}${CRE}Failed to adjust Picom settings${CNC}"
            fi
        else
            printf "%b\n\n" "${BLD}${CRE}Picom config file missing: ${CYE}${picom_config}${CNC}"
        fi

        if [ -f "$picom_config" ]; then
            if sed -i 's/vsync = true/vsync = false/' "$picom_config"; then
                printf "%b\n\n" "${BLD}${CGR}Picom vSync disabled${CNC}"
            else
                printf "%b\n\n" "${BLD}${CRE}Failed to adjust Picom settings${CNC}"
            fi
        else
            printf "%b\n\n" "${BLD}${CRE}Picom config file missing: ${CYE}${picom_config}${CNC}"
        fi
    fi
    sleep 3
}

change_default_shell() {
    clear
    logo "Changing default shell to zsh"
    zsh_path=$(command -v zsh)
    sleep 2

    if [ -z "$zsh_path" ]; then
        printf "%b\n\n" "${BLD}${CRE}Zsh is not installed! Cannot change shell${CNC}"
    fi

    if [ "$SHELL" != "$zsh_path" ]; then
        printf "%b\n" "${BLD}${CYE}Changing your shell to Zsh...${CNC}"

        if chsh -s "$zsh_path"; then
            printf "%b\n" "\n${BLD}${CGR}Shell changed successfully!${CNC}"
        else
            printf "%b\n\n" "\n${BLD}${CRE}Error changing shell!{CNC}"
        fi
    else
        printf "%b\n\n" "${BLD}${CGR}Zsh is already your default shell!${CNC}"
    fi
    sleep 3
}

final_prompt() {
    clear
    logo "Installation Complete"

    printf "%b\n" "${BLD}${CGR}Installation completed successfully!${CNC}"
    printf "%b\n\n" "${BLD}${CRE}You ${CBL}MUST ${CRE}restart your system to apply changes${CNC}"

    while :; do
        printf "%b" "${BLD}${CYE}Reboot now?${CNC} [y/N]: "
        read -r yn
        case "$yn" in
            [Yy]) printf "\n%b\n" "${BLD}${CGR}Initiating reboot...${CNC}"
                sleep 1
                sudo reboot
                break ;;
            [Nn]|"") printf "\n%b\n\n" "${BLD}${CYE}You really need to reboot bro!!${CNC}"
                    break ;;
            *) printf " %b%bError:%b write 'y' or 'n'\n" "${BLD}" "${CRE}" "${CNC}" ;;
        esac
    done
}

