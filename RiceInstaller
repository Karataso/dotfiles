# Colors
CRE=$(tput setaf 1)    # Red
CYE=$(tput setaf 3)    # Yellow
CGR=$(tput setaf 2)    # Green
CBL=$(tput setaf 4)    # Blue
BLD=$(tput bold)       # Bold
CNC=$(tput sgr0)       # Reset colors

# Step banners: plain ASCII and colour only, so they still read on a bare tty.
STEP=0
TOTAL=15

banner() {
    clear
    printf "%s%s============================================================%s\n" "$BLD" "$CBL" "$CNC"
    printf "%s  %s%s\n" "$BLD" "$1" "$CNC"
    printf "%s%s============================================================%s\n\n" "$BLD" "$CBL" "$CNC"
}

step() {
    STEP=$((STEP + 1))
    clear
    printf "%s%s[%s/%s]%s %s%s%s\n" "$BLD" "$CBL" "$STEP" "$TOTAL" "$CNC" "$BLD" "$1" "$CNC"
    printf "%s%s------------------------------------------------------------%s\n\n" "$CBL" "" "$CNC"
}

