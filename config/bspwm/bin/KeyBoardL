#!/bin/sh
# Description: rofi + setxkbmap layout picker. The chosen layout is written to
# config/kb_layout, and bspwmrc re-applies it on every login, so a
# layout survives logout, reboot and theme switches.
# Features:
# - Layouts with the international variants (dead keys, AltGr symbols)
# - Rofi-driven interactive menu
# - Real-time current layout display
# gh0stzk — GPL-3.0 | https://github.com/gh0stzk/dotfiles

KB_CONF="$HOME/.config/bspwm/config/kb_layout"

# Current layout: "us (intl)" when a variant is in use
CURRENT=$(setxkbmap -query 2>/dev/null | awk '
    /^layout:/  { l = $2 }
    /^variant:/ { v = $2 }
    END { if (l != "") print (v != "" ? l " (" v ")" : l) }')

# "<label>|<layout> [variant]" — add yours the same way
LAYOUTS="US English|us
US International (dead keys)|us intl
US International (AltGr dead keys)|us altgr-intl
US Dvorak International|us dvorak-intl
Spanish (Spain)|es
Spanish (Spain, dead tilde)|es deadtilde
Spanish (Latin America)|latam
Spanish (Latin America, dead tilde)|latam deadtilde
French|fr
French (OSS, all symbols)|fr oss
French (Bépo)|fr bepo
German|de
German (dead keys)|de deadtilde
Italian|it
Brazilian Portuguese|br
Brazilian Portuguese (US keys, dead keys)|br nativo-us
Russian|ru
Russian (phonetic)|ru phonetic"

show_rofi_menu() {
    printf '%s\n' "$LAYOUTS" | cut -d'|' -f1 | rofi \
        -dmenu \
        -p "Keyboard Layout" \
        -mesg "Current layout --> ${CURRENT:-unknown}
Dead keys and AltGr symbols come from the variant; the choice is saved." \
        -markup-rows \
        -theme "$HOME/.config/bspwm/config/rofi-themes/Keyboard.rasi"
}

selected=$(show_rofi_menu)
[ -n "$selected" ] || exit 0

layout_spec=$(printf '%s\n' "$LAYOUTS" | awk -F'|' -v sel="$selected" '$1 == sel { print $2 }')
[ -n "$layout_spec" ] || exit 0

set -- $layout_spec
layout=$1
variant=$2

args="-layout $layout"
[ -n "$variant" ] && args="$args -variant $variant"

if setxkbmap $args 2>/dev/null; then
    printf '%s\n' "$layout_spec" > "$KB_CONF"
else
    rofi -e "Could not apply ${layout_spec}"
fi
