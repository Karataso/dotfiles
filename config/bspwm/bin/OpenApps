#!/bin/sh
# Script to control prefered apps to launch for all themes
# gh0stzk — GPL-3.0 | https://github.com/gh0stzk/dotfiles

WIDGET_DIR="$HOME/.config/bspwm/eww"

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		kitty
		;;
	--floating)
		kitty --class=FloaTerm
		;;
	--checkupdates)
		kitty -o background_opacity=0.93 --class=Updating -e Updates --print-updates
		;;
	--netmanager)
		NetManagerDM
		;;
	--pass)
		RofiPass
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--android)
		AndroidMount
		;;
	--keyboard)
		KeyBoardL
		;;
	--music)
		kitty --name=MusicTerm --class=FloaTerm -e ncmpcpp
		;;
	--fetch)
		rice=$(tr -d '\r\n' < "$HOME/.config/bspwm/.rice" 2>/dev/null)
		fetch_config="$HOME/.config/bspwm/rices/$rice/fastfetch.jsonc"
		if command -v fastfetch >/dev/null 2>&1 && [ -f "$fetch_config" ]; then
			kitty --name=FetchTerm --class=FloaTerm -e fastfetch --config "$fetch_config"
		else
			kitty --name=FetchTerm --class=FloaTerm -e sh -c 'printf "fastfetch is not installed, or the current rice has no fastfetch.jsonc.\n"; sleep 4'
		fi
		;;
	--scratch)
		Bspwm-ScratchPad
		;;
		# Apps
    --filemanager)
        ${FILEMANAGER:-thunar}
        ;;
    --browser)
        ${BROWSER:-firefox}
        ;;
    --editor)
        ${EDITOR:-geany}
		;;
	--telegram)
		telegram-desktop
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		Help
		;;
	--usercard)
		eww -c "$WIDGET_DIR" open --toggle launchermenu
		;;
	--player)
		eww -c "$WIDGET_DIR" open --toggle music
		;;
	*)
		echo "Invalid Option"
		;;
esac
