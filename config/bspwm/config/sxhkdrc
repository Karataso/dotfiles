# Keybinds, read by sxhkd. alt + F1 shows the sheet.
# ctrl + alt + key     applications: launch and toggle
# super + key          windows and workspaces
# super + alt + key    session and bspwm control
# super + ctrl + key   resize, balance, send, multi-window
# alt + key            the focused window
# alt + F1             the cheat sheet, generated from this file
# gh0stzk — GPL-3.0 | https://github.com/gh0stzk/dotfiles

# Show the keybind cheat sheet
alt + F1
    OpenApps --KeyHelp

# -- System -- #

# Volume mixer (pavucontrol)
super + p
    OpenApps --soundcontrol

# Network manager
ctrl + alt + n
    OpenApps --netmanager

# Bluetooth
ctrl + alt + b
    OpenApps --bluetooth

# Clipboard history
ctrl + alt + v
    OpenApps --clipboard

# Screenshot
ctrl + alt + s
    OpenApps --screenshot

# Keyboard layout
ctrl + alt + k
    OpenApps --keyboard

# Wallpaper selector
super + w
    WallSelect

# Mount Android phone
super + alt + a
    OpenApps --android

# Host checks (updates, weather, system vars)
super + alt + i
    OpenApps --checkupdates

# Lock screen
ctrl + alt + l
    ScreenLocker

# Power menu (shutdown, reboot, logout, lock)
ctrl + alt + p
    OpenApps --powermenu

# Hardware power button
XF86PowerOff
    OpenApps --powermenu

# -- User -- #

# Password manager (RofiPass)
ctrl + alt + x
    RofiPass

# Rofi style
super + alt + l
    RofiLauncher --choose-style

# Scratchpad
ctrl + t
    OpenApps --scratch

# Restore hidden windows
ctrl + alt + h
    HideNode --menu

# -- Apps -- #

# App launcher
alt + @space
    OpenApps --menu

# Terminal
ctrl + alt + t
    OpenApps --terminal

# Terminal (floating)
ctrl + alt + shift + t
    OpenApps --floating

# Theme (rice) selector
super + @space
    RiceSelector

# Bar selector
super + alt + @space
    BarSelector

# Terminal selector
super + alt + t
    Term --selecterm

# Browser
ctrl + alt + w
    OpenApps --browser

# File manager (Thunar)
ctrl + alt + e
    OpenApps --filemanager

# Text editor (Geany)
ctrl + alt + f
    OpenApps --editor

# Music player (ncmpcpp)
ctrl + alt + m
    OpenApps --music

# Music downloader (albumdown)
ctrl + alt + d
    OpenApps --albumdown

# Telegram
ctrl + alt + g
    OpenApps --telegram

# Rice editor
super + r
    RiceEditor

# -- Desktop -- #

# Reload bspwm
super + alt + r
    bspc wm -r

# Soft reload (restart daemons)
super + alt + shift + r
    SoftReload

# Reload sxhkd keybinds
super + Escape
    pkill -USR1 -x sxhkd; dunstify -u low -i ~/.config/bspwm/config/assets/reload.svg 'sxhkd' 'The configuration file has been reloaded successfully!'

# Quit bspwm session
super + alt + q
    bspc quit

# Hide bar
super + alt + h
    HideBar -h

# Unhide bar
super + alt + u
    HideBar -u

# Rotate the desktop
ctrl + Tab
    bspc node @/ --rotate 90

# -- Window state -- #

# Window state: tiled / pseudo-tiled / floating / fullscreen
alt + {t,shift + t,a,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Window flag: marked / locked / sticky / private
alt + {m,x,s,p}
    bspc node -g {marked,locked,sticky,private}

# Hide focused window
alt + h
    HideNode --hide

# Close focused window
alt + F4
    bspc node -c

# Force kill focused window
alt + shift + F4
    bspc node -k

# Window switcher
alt + Tab
    rofi \
        -theme $HOME/.config/bspwm/config/rofi-themes/Windows.rasi \
        -show window -window-thumbnail \
        -window-hide-active-window true \
        -kb-accept-entry "!Alt-Tab,Return" \
        -kb-element-next "Alt-Tab"

# Window transparency: increase / decrease / reset
alt + {plus,minus,0}
    picom-trans {-c -3,-c +3,-c -d}

# -- Window size -- #

# Balance all windows on the desktop
super + ctrl + b
    bspc node @/ -B

# Grow / shrink the focused tiled window
super + alt + {plus,minus}
    { \
       bspc node -z top_right 20 -20 ; bspc node -z bottom_left -20 20; \
    ,  bspc node -z top_right -20 20 ; bspc node -z bottom_left 20 -20; \
    }

# Grow / shrink the focused floating window
super + ctrl + {plus,minus}
    { \
        xdotool getactivewindow windowmove --relative -- -50 -25 ; xdo resize -w +100 -h +50; \
        , xdotool getactivewindow windowmove --relative -- +50 +25 ; xdo resize -w -100 -h -50; \
    }

# Resize: shrink width / expand height / shrink height / expand width
super + ctrl + {h,j,k,l}
    { bspc node -z right -40 0 || bspc node -z left 40 0 \
    , bspc node -z bottom 0 40 || bspc node -z top 0 40 \
    , bspc node -z bottom 0 -40 || bspc node -z top 0 -40 \
    , bspc node -z right 40 0 || bspc node -z left -40 0 \
    }

# Preselect direction: east / south / cancel
super + ctrl + shift + {h,v,q}
    bspc node -p {east,south,cancel}

# -- Focus -- #

# Focus the window in the given direction
super + alt + {Left,Down,Up,Right}
    { DIR=west FALLBACK=prev; , DIR=south; , DIR=north; , DIR=east FALLBACK=next; } \
    bspc node -f $DIR.!sticky.!hidden.local || bspc node -f $FALLBACK.leaf.!sticky.!hidden.local

# Swap the focused window with the one in the given direction
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}.local

# Move the focused floating window
super + alt + shift + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Focus the last window / last workspace
super + {comma,period}
    bspc {node,desktop} -f last

# -- Workspaces -- #

# Switch workspace
super + {Left,Right}
    bspc desktop -f {prev,next}

# Focus a specific workspace
super + {1-9,0}
    bspc desktop -f '^{1-9,10}'

# Send window to a specific workspace
super + ctrl + {1-9,0}
    bspc node -d '^{1-9,10}'

# Send focused window to prev / next workspace (follow it)
super + ctrl + {Left,Right}
    bspc node -d {prev,next} '--follow'

# -- Multi-window -- #

# Close all windows on the current desktop
super + ctrl + x
    bspc query -N -d | xargs -I id -n 1 bspc node id -c

# Close / kill all unfocused local windows
super + n ; {x,k}
    bspc query -N -n '.!focused.!marked.local.window' | xargs -I id -n 1 bspc node id {-c,-k}

# Bring all marked windows to the focused desktop
super + n ; m
    bspc query -N -n '.marked' | xargs -I id -n 1 bspc node id -d focused --follow

# Bring everything from workspace X to the current one (super + n, then X)
super + n ; {1-9}
    bspc query -N -d {1-9} -n '.window' | xargs -I id -n 1 bspc node id -d focused

# -- Hardware keys -- #

# Manage brightness
XF86MonBrightness{Up,Down}
    sh Brightness {up,down}

# Volume control
XF86Audio{RaiseVolume,LowerVolume,Mute}
    Volume{ --inc, --dec, --toggle}

# Music control
XF86Audio{Next,Prev,Play,Stop}
    MediaControl {--next,--previous,--toggle,--stop}

# -- Desktop menu -- #

# Right click on the desktop opens jgmenu
~button3
    win=$(xdotool getmouselocation --shell | sed -n 's/^WINDOW=\(.*\)/\1/p'); \
    type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null); \
    case "$type" in *DESKTOP*) \
        jgmenu --csv-file="$HOME/.config/bspwm/config/jgmenu.txt" \
               --config-file="$HOME/.config/bspwm/config/jgmenurc";; esac
